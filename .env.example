# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git. Never commit real keys.

# Data source mode:
#   synthetic = built-in high fidelity demo data (default)
#   supabase  = real PostgreSQL data from Supabase
VITE_DATA_SOURCE=synthetic

# Supabase configuration (when using live database mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenAI API Key for real-time algorithmic code analysis and anomaly explanation
# (Can also be entered interactively in the app UI)
VITE_OPENAI_API_KEY=
